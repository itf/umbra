# Dependencies
node_modules/

# Build output
dist/
dev-dist/
# ...but the vendored prebuilt three-steam-audio package (fork: SOFA + head-tracked
# reflections) IS committed — its dist/ is the shipped artifact (see vendor/README).
!vendor/three-steam-audio/dist/
!vendor/three-steam-audio/dist/**

# Generated WASM (build with `npm run wasm`)
src/engine/acoustics/wasm/

# Rust build artifacts
acoustics-core/target/

# Editor/OS
.DS_Store
*.log
.vscode/
.idea/

# Scratch
*.tmp

# Raw SOFA HRTF source (large; download from Zenodo + run scripts/bake-hrtf.mjs).
# The baked compact binary assets/hrtf/*.hrtf IS committed.
assets/hrtf/*.sofa

# Generated HRTF worklet bundle (built by scripts/build-worklet.mjs on dev/build)
public/hrtf-worklet.js

# Playwright e2e artifacts
test-results/
playwright-report/
