{
  "name": "papasangre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Audio-only navigation game + echolocation trainer (PWA) with custom HRTF and image-source room acoustics.",
  "scripts": {
    "wasm": "wasm-pack build acoustics-core --target web --out-dir ../src/engine/acoustics/wasm --release",
    "wasm:dev": "wasm-pack build acoustics-core --target web --out-dir ../src/engine/acoustics/wasm --dev",
    "worklet": "node scripts/build-worklet.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dev": "npm run worklet && vite",
    "build": "npm run wasm && npm run worklet && npm run icons && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "h5wasm": "^0.7.9",
    "node-web-audio-api": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-steam-audio": "0.1.0-beta.1"
  }
}
